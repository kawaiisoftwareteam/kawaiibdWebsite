# Next.js static export on LiteSpeed / Apache (cPanel)
# Fixes ERR_TOO_MANY_REDIRECTS caused by /en ↔ /en/ fighting each other.

Options -Indexes +FollowSymLinks
DirectoryIndex index.html

# Critical: do NOT auto-redirect /en → /en/ (that fights host "strip slash" rules)
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Already a real file → serve it
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /en/ or /en/about/ → serve .../index.html (no external redirect)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # /en or /en/about (no trailing slash) → serve .../index.html when that folder exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

# If a folder is requested and somehow still has no index, don't list files
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
